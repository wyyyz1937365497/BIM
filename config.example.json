{
  "vlm": {
    "comment": "VLM 用于管线图像验证（智谱 GLM-5V-Turbo OpenAI 兼容接口）",
    "provider": "openai",
    "api_base": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-5v-turbo",
    "api_key": ""
  },
  "revit_mcp": {
    "comment": "Revit MCP Server (stdio transport)",
    "command": "node",
    "args": ["G:/TJ/BIM/mcp-servers-for-revit/server/build/index.js"],
    "timeout": 120
  },
  "falcon": {
    "comment": "Falcon-Perception 分割服务 (conda env: transformerv)",
    "host": "127.0.0.1",
    "port": 18390,
    "timeout": 300
  },
  "trellis": {
    "comment": "TRELLIS B类复杂构件 mesh 生成服务 (conda env: trellis)",
    "host": "127.0.0.1",
    "port": 18391,
    "model": "microsoft/TRELLIS-image-large",
    "timeout": 1800
  },
  "pose_refiner": {
    "comment": "可选 B 类 mesh 残差姿态精修（需先训练 checkpoint）",
    "enabled": false,
    "checkpoint": "output/pose_refiner.pt",
    "device": "cuda",
    "input_size": 128,
    "iterations": 2,
    "confidence_threshold": 0.65,
    "min_quality_score": 0.20,
    "quality_tolerance": 0.02,
    "min_mask_pixels": 256,
    "min_depth_ratio": 0.02,
    "max_rotation_degrees": 20.0,
    "max_translation_m": 0.25,
    "max_log_scale": 0.15,
    "gravity_locked": true,
    "floor_contact": true
  },
  "viewer_service": {
    "comment": "独立 Mini Viewer 进程管理 API（bim-recon 环境）",
    "host": "127.0.0.1",
    "port": 18083,
    "viewer_port": 18081
  },
  "element_routing": {
    "comment": "A=参数化Revit图元(Wall/Door/Window), B=TRELLIS mesh+DirectShape",
    "door": "A",
    "window": "A",
    "column": "A",
    "furniture": "B"
  }
}
